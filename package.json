{
  "name": "@hraness/message-like-me",
  "version": "0.2.0",
  "description": "A local-first CLI and Agent Skill for studying your private iMessage history and drafting messages that sound like you.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/message-like-me.git"
  },
  "homepage": "https://messagelikeme.com",
  "bugs": {
    "url": "https://github.com/hraness/message-like-me/issues"
  },
  "keywords": [
    "agent-skill",
    "bun",
    "cli",
    "imessage",
    "local-first",
    "messaging-style",
    "privacy"
  ],
  "bin": {
    "messagelikeme": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "schema",
    "skills",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build-dist.ts",
    "test": "bun test ./src ./scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:skill": "bun scripts/validate-skill.ts",
    "check:standalone": "bun scripts/check-standalone.ts",
    "check:dist": "bun scripts/check-dist.ts",
    "check:package": "bun scripts/package-smoke.ts",
    "check": "bun run typecheck && bun run test && bun run check:skill && bun run check:standalone && bun run build && bun run check:dist && bun run check:package",
    "prepack": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
