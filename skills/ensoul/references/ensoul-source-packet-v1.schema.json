{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hraness.com/schemas/ensoul-source-packet-v1.schema.json",
  "title": "Ensoul source packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "digestCanonicalization",
    "packetId",
    "generatedAt",
    "subject",
    "scope",
    "records",
    "limitations",
    "packetDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "ensoul.source-packet.v1" },
    "digestCanonicalization": { "const": "JCS-RFC8785" },
    "packetId": { "type": "string", "minLength": 8, "maxLength": 160 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/subject" },
    "scope": { "$ref": "#/$defs/scope" },
    "records": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/record" }
    },
    "claims": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/claim" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "packetDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localId", "kind", "identityBasis"],
      "properties": {
        "localId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["owner", "contact", "person"] },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 300 },
        "identityBasis": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "payloadSchema", "completeness", "limits"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1, "maxLength": 100 },
        "payloadSchema": { "type": "string", "minLength": 1, "maxLength": 160 },
        "asOf": { "type": "string", "format": "date-time" },
        "sourceCutoff": { "type": "string", "format": "date-time" },
        "completeness": { "enum": ["complete", "sampled", "bounded", "unknown"] },
        "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 300 },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": ["string", "integer", "boolean", "null"],
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            ]
          },
          "maxProperties": 32
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "maxLength": 50000 },
        "title": { "type": "string", "maxLength": 1000 },
        "url": { "type": "string", "format": "uri", "maxLength": 4096 },
        "truncated": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["text"] },
        { "required": ["title"] },
        { "required": ["url"] }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "contentSha256"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "kind",
        "authorRole",
        "contentRole",
        "authorshipConfidence",
        "sentStatus",
        "visibility",
        "sourceClass",
        "content",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "observedAt": { "type": "string", "format": "date-time" },
        "authorRole": { "enum": ["subject", "counterpart", "third_party", "mixed", "unknown"] },
        "contentRole": { "enum": ["original", "quoted", "forwarded", "summary", "ai_assisted", "mixed", "unknown"] },
        "authorshipConfidence": { "enum": ["verified", "strong", "weak", "unknown"] },
        "sentStatus": { "enum": ["sent", "draft", "received", "published", "unknown"] },
        "visibility": { "enum": ["public", "private"] },
        "sourceClass": {
          "enum": [
            "private_capture",
            "polished_self_presentation",
            "observed_behavior",
            "public_web_evidence",
            "third_party_description",
            "institutional",
            "metadata"
          ]
        },
        "content": { "$ref": "#/$defs/content" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "anyOf": [
        { "required": ["occurredAt"] },
        { "required": ["observedAt"] }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "recordIds", "status", "claimantRole", "claimKind", "subjectLocalId", "sensitivity"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "status": { "enum": ["source_reported", "adapter_structured", "contested"] }
        ,"claimantRole": { "enum": ["subject", "counterpart", "third_party", "institutional", "adapter", "unknown"] }
        ,"claimKind": { "enum": ["fact", "stated_belief", "reported_observation", "derived_index"] }
        ,"subjectLocalId": { "type": "string", "minLength": 1, "maxLength": 200 }
        ,"sensitivity": { "enum": ["ordinary", "sensitive_explicit"] }
      }
    }
  }
}
