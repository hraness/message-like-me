{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Textbutler",
  "version": "0.1.1",
  "identifier": "app.textbutler.desktop",
  "build": { "frontendDist": "../out/native" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Textbutler", "width": 1080, "height": 830, "minWidth": 760, "minHeight": 600, "center": true, "create": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "14.5" }
  }
}
