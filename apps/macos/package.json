{
  "name": "@textbutler/macos",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:demo": "bun scripts/build.ts --demo",
    "typecheck": "../../node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "test": "bun test src scripts distribution",
    "check": "bun run typecheck && bun run test && bun run build && bun run build:demo",
    "preview": "bun scripts/serve.ts",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "native:run": "cargo run --manifest-path src-tauri/Cargo.toml --locked",
    "native:package": "bun scripts/package.ts",
    "native:smoke": "bun scripts/package-smoke.ts"
  }
}
