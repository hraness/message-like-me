{
  "name": "textbutler-launch-film",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun build.ts",
    "build:square": "bun build.ts --aspect 1:1",
    "build:portrait": "bun build.ts --aspect 9:16",
    "draft": "bun build.ts --scale 0.5 --fps 15",
    "still": "bun build.ts && slopcamera html still --input out/scene.json --at 3,8,12,17,21,26,30,34 --output out/stills",
    "render": "slopcamera html render --input out/scene.json --json > out/export.json",
    "deliver": "slopcamera html deliver out/export.json --basename textbutler-launch --poster-at 12 --social-at 17 --cuts 1:1 --beats out/beats.json --per-beat-clips --output out/deliver",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.29.2",
    "@hraness/slopcamera": "3.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "6.0.3"
  }
}
